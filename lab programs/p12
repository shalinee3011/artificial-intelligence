import math

# Game tree as nested lists: leaf = score, list = children
tree = [[[3, 5], [6, 9]], [[1, 2], [0, -1]]]

def minimax(node, depth, is_max):
    if not isinstance(node, list):
        print("  Leaf reached, value =", node)
        return node

    if is_max:
        best = -math.inf
        for child in node:
            best = max(best, minimax(child, depth + 1, False))
        print("MAX node at depth", depth, "->", best)
        return best
    else:
        best = math.inf
        for child in node:
            best = min(best, minimax(child, depth + 1, True))
        print("MIN node at depth", depth, "->", best)
        return best

print("Minimax Algorithm\n")
result = minimax(tree, 0, True)
print("\nOptimal value for MAX player:", result)
