from collections import deque

start = (3, 3, 0)
goal = (0, 0, 1)

moves = [(1, 0), (2, 0), (0, 1), (0, 2), (1, 1)]

def safe(m, c):
    return 0 <= m <= 3 and 0 <= c <= 3 and \
           (m == 0 or m >= c) and \
           (3-m == 0 or 3-m >= 3-c)

q = deque([(start, [])])
visited = set()

while q:
    state, path = q.popleft()

    if state in visited:
        continue
    visited.add(state)

    if state == goal:
        for s in path + [state]:
            print(s)
        break

    m, c, boat = state

    for dm, dc in moves:
        if boat == 0:
            new = (m-dm, c-dc, 1)
        else:
            new = (m+dm, c+dc, 0)

        if safe(new[0], new[1]) and new not in visited:
            q.append((new, path + [state]))
